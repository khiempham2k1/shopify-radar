# Shopify Radar web dashboard

# FastAPI backend (server-side only; browsers never call it directly)
# docker compose: http://api:8000 · chạy local trên máy: http://127.0.0.1:8000
RADAR_API_URL=http://api:8000
# Must match RADAR_API_TOKEN of the API service (để trống nếu API chạy local không đặt token)
RADAR_API_TOKEN=change-me

# next-auth
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Phase 1 pages are readable without signing in. Only admins sign in (open /login directly):
# these comma-separated emails, who also get Phase 2 (Báo cáo tuần, Cài đặt, Chi phí AI)
PHASE2_EMAILS=lead@example.com

# Local development only: skip Google login (user becomes dev@local)
AUTH_DISABLED=false
