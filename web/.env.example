# Shopify Radar web dashboard

# FastAPI backend (server-side only; browsers never call it directly)
RADAR_API_URL=http://api:8000
# Must match RADAR_API_TOKEN of the API service
RADAR_API_TOKEN=change-me

# next-auth
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated email domains allowed to sign in, e.g. example.com,example.vn
ALLOWED_EMAIL_DOMAINS=example.com

# Local development only: skip Google login (user becomes dev@local)
AUTH_DISABLED=false
