# Sao chép thành .env rồi điền giá trị. Không commit file .env.

# Postgres (docker compose tự tạo DB)
POSTGRES_PASSWORD=doi-mat-khau-nay

# Token chung giữa web và API (chuỗi ngẫu nhiên dài): openssl rand -hex 32
RADAR_API_TOKEN=

# Claude: phân loại, tóm tắt, báo cáo tuần
ANTHROPIC_API_KEY=
# Groq: chỉ dùng speech-to-text cho video không có phụ đề.
# Nhiều key ngăn bằng dấu phẩy: radar dùng xoay vòng, key bị giới hạn (429) thì tạm nghỉ
# đúng thời gian Groq báo và chuyển sang key khác. GROQ_API_KEY (một key) vẫn dùng được.
GROQ_API_KEYS=
GROQ_API_KEY=

# Tài khoản X riêng cho radar (cookie lấy bằng Cookie-Editor)
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
# Discord: token của TÀI KHOẢN DISCORD RIÊNG CHO RADAR (không dùng tài khoản chính), đã vào server cộng đồng.
# Lấy bằng `discord auth --save` trên máy đang đăng nhập tài khoản đó, hoặc từ DevTools của trình duyệt.
# Discord không cho phép tự động hóa bằng tài khoản thường; tài khoản có thể bị khóa.
DISCORD_TOKEN=

RADAR_TIMEZONE=Asia/Ho_Chi_Minh
# Proxy nếu IP server bị Reddit/YouTube chặn (thường không cần trên server nội bộ); yt-dlp cũng dùng proxy này
RADAR_HTTP_PROXY=
# Cookie YouTube (cookies.txt, định dạng Netscape) của tài khoản Google riêng cho radar, khi YouTube đòi
# "confirm you're not a bot". Mặc định: secrets/youtube/cookies.txt (docker compose đã gắn sẵn thư mục này).
# YOUTUBE_COOKIES=

# VPS (deploy/setup-vps.sh tự điền).
# Chạy bằng IP: dashboard ở http://<ip>:WEB_PORT, NEXTAUTH_URL=http://<ip>:WEB_PORT.
# Có domain: Caddy tự lấy HTTPS cho DOMAIN, NEXTAUTH_URL=https://DOMAIN, thêm deploy/docker-compose.https.yml.
WEB_PORT=3000
DOMAIN=
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.vps.yml

# Web (Next.js)
# Giai đoạn 1 (Tổng quan, Thay đổi nền tảng, Feed, Sức khỏe nguồn) xem được không cần đăng nhập.
# Chỉ quản trị đăng nhập, bằng cách mở thẳng /login; dashboard không có link đăng nhập.
# Hai cách đăng nhập, bật cách nào thì điền cách đó:
#   - Google (cần domain HTTPS; Google không nhận địa chỉ IP): GOOGLE_CLIENT_ID/SECRET;
#   - mật khẩu: email trong PHASE2_EMAILS + ADMIN_PASSWORD (dùng khi chạy bằng IP).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_PASSWORD=
# Email quản trị, ngăn bằng dấu phẩy: chỉ các email này đăng nhập được và xem Giai đoạn 2
# (Báo cáo tuần, Cài đặt, Chi phí AI) cùng chi tiết kỹ thuật.
PHASE2_EMAILS=lead@congty.com,pm@congty.com
# Chỉ dùng khi chạy local: bỏ đăng nhập, mọi trang đều mở (kể cả Giai đoạn 2)
AUTH_DISABLED=false
